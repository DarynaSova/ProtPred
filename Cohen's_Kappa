import pandas as pd
from sklearn.metrics import cohen_kappa_score
import seaborn as sns
import matplotlib.pyplot as plt

import numpy as np
def compute_cohen_kappa_manual(x, y):
    tp = np.sum((x == 1) & (y == 1))
    tn = np.sum((x == 0) & (y == 0))
    fp = np.sum((x == 0) & (y == 1))
    fn = np.sum((x == 1) & (y == 0))
    total = tp + tn + fp + fn
    if total == 0:
        return 0
    po = (tp + tn) / total
    px_yes = (tp + fn) / total
    py_yes = (tp + fp) / total
    px_no = (tn + fp) / total
    py_no = (tn + fn) / total
    pe = px_yes * py_yes + px_no * py_no
    return (po - pe) / (1 - pe) if (1 - pe) != 0 else 0


# Load the dataset containing both raw and z-score values
df = pd.read_csv(r'residue_level_wide_format_zscore_norm.csv')

# Define raw thresholds for metrics (except 'bfactors', already z-score)
raw_thresholds = {
    'rmsf': 2,
    'plddt': 80,
    'gscore': 0.65
}

# Add fixed z-score threshold for 'bfactors'
z_thresholds = {'bfactors': 2}

# Calculate mean and std for converting raw thresholds
for metric, raw_thresh in raw_thresholds.items():
    if metric in df.columns:
        mean = df[metric].mean()
        std = df[metric].std()
        z_thresh = (raw_thresh - mean) / std
        z_thresholds[metric] = z_thresh
    else:
        print(f"Warning: Raw metric '{metric}' not found in DataFrame.")

print("\nRaw means and stds:")
for metric in raw_thresholds:
    print(f"{metric}: mean = {df[metric].mean():.3f}, std = {df[metric].std():.3f}")

# Print thresholds for verification
print("Z-score thresholds used for binary classification:")
for k, v in z_thresholds.items():
    print(f"  {k}: {v:.3f}")

# Define which metrics to invert (low values = disorder)
invert = {'plddt'}

# Apply thresholds to create binary disorder calls
for metric, z_thresh in z_thresholds.items():
    zscore_col = metric + '_zscore'
    binary_col = metric + '_binary'

    if zscore_col not in df.columns:
        print(f"Warning: Z-score column '{zscore_col}' not found.")
        continue

    if metric in invert:
        df[binary_col] = (df[zscore_col] < z_thresh).astype(int)
    else:
        df[binary_col] = (df[zscore_col] > z_thresh).astype(int)

# Gather all binary columns
binary_cols = [f'{metric}_binary' for metric in z_thresholds.keys() if f'{metric}_binary' in df.columns]

# Initialize empty kappa matrix
kappa_matrix = pd.DataFrame(index=binary_cols, columns=binary_cols, dtype=float)

# Compute pairwise Cohen's kappa
print("\nPairwise Cohen's Kappa Scores:")

for m1 in binary_cols:
    for m2 in binary_cols:
        if m1 == m2:
            kappa_matrix.loc[m1, m2] = 1.0
        else:
            kappa = compute_cohen_kappa_manual(df[m1], df[m2])
            kappa_matrix.loc[m1, m2] = kappa
            if binary_cols.index(m1) < binary_cols.index(m2):
                print(f"  {m1} vs {m2}: {kappa:.3f}")


print("\nBinary value counts per metric:")
for col in binary_cols:
    print(f"{col}: {df[col].value_counts().to_dict()}")


# Plot heatmap
plt.figure(figsize=(8, 6))
sns.heatmap(kappa_matrix, annot=True, cmap='coolwarm', vmin=-1, vmax=1, square=True, cbar_kws={"label": "Cohen's Kappa"})
plt.title("Pairwise Cohen's Kappa Scores Between Disorder Metrics")
plt.tight_layout()
plt.show()



